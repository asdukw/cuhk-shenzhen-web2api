# Host port for the local Firecrawl-compatible scrape API.
FIRECRAWL_PORT=3002

# Conservative defaults for development machines.
NUM_WORKERS_PER_QUEUE=4
CRAWL_CONCURRENT_REQUESTS=5
MAX_CONCURRENT_JOBS=3
BROWSER_POOL_SIZE=2

# Local queue database. Change these only together.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
