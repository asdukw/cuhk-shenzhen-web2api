# Local Steel browser stack (Node, no Docker).
# First run: .\scripts\local_steel.ps1 setup
# Start/stop: .\scripts\local_steel.ps1 up|down|status|verify|logs
# BROWSER_BACKEND may be omitted; only steel-local is supported.
BROWSER_BACKEND=steel-local
STEEL_EXECUTOR_URL=http://127.0.0.1:3003
STEEL_EXECUTOR_TOKEN=steel-local-only
# STEEL_EXECUTOR_TIMEOUT=130
# STEEL_API_PORT=3000
# STEEL_CDP_PORT=9223
# STEEL_HEADLESS=true
# STEEL_SOURCE_DIR=.steel/steel-browser
# STEEL_REVISION=dacea7e217ccded0d3886b8771a0ae52d254552c
# CHROME_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# CHROME_USER_DATA_DIR=data/steel/chrome-profile

# SSO credentials; CHAT_USERNAME/CHAT_PASSWORD override these aliases.
USERNAME=
PASSWORD=
