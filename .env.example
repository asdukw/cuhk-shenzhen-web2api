# ============================================================
# Firecrawl 后端选择：cloud = 官方云服务，local = 本地/自托管部署
# ------------------------------------------------------------
# cloud（默认）: https://api.firecrawl.dev，需要 FIRECRAWL_API_KEY
# local        : 默认 http://127.0.0.1:3002（仓库自带的本地 scrape API）
# local 负责 scrape；浏览器会话由下方 BROWSER_BACKEND 独立选择。
# ============================================================
FIRECRAWL_MODE=cloud

# 云模式必填；本地模式可留空（自托管默认 USE_DB_AUTHENTICATION=false，会忽略该头）
FIRECRAWL_API_KEY=fc-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 可选：覆盖后端地址
# FIRECRAWL_API_URL=http://127.0.0.1:3002

# 可选调优（仅浏览器会话路径使用）
# FIRECRAWL_RATE_SLEEP=3.5   # 每次浏览器调用前的等待秒数（cloud 3.5 / local 0.5）
# FIRECRAWL_MAX_TTL=3600     # 浏览器会话最大存活秒数（两种模式均不超过 3600）
# FIRECRAWL_TIMEOUT=120      # HTTP 请求超时秒数

# ============================================================
# 浏览器后端：firecrawl-cloud（默认云模式）或 steel-local（默认本地模式）
# ------------------------------------------------------------
# 未设置时随 FIRECRAWL_MODE：cloud -> firecrawl-cloud，local -> steel-local。
# 也可显式拆分，例如本地 Firecrawl 抓取 + Firecrawl Cloud 浏览器。
# ============================================================
# BROWSER_BACKEND=steel-local

# Steel 本地执行器（.\scripts\local_steel.ps1 up）
# STEEL_EXECUTOR_URL=http://127.0.0.1:3003
# STEEL_EXECUTOR_TOKEN=steel-local-only
# STEEL_EXECUTOR_TIMEOUT=130

# FIRECRAWL_MODE=local 但浏览器仍用云端时，可单独覆盖浏览器 API 地址：
# FIRECRAWL_BROWSER_API_URL=https://api.firecrawl.dev

# ------------------------------------------------------------
# 账号密码走完整 SSO 流程（ADFS 登录 -> aTrust 兑换 -> 自动登录 chat）
# ------------------------------------------------------------
# Student: full ID e.g. 1XXXXXXX (or yourname@cuhk.edu.cn)
USERNAME=
PASSWORD=
