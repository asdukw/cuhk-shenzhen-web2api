# ============================================================
# Firecrawl API key (from https://www.firecrawl.dev)
# Required: the chat session lives in a Firecrawl cloud browser
# because aTrust cookies are bound to that browser's IP.
# ============================================================
FIRECRAWL_API_KEY=fc-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------
# Optional automatic SSO (ADFS -> aTrust -> chat).
# Leave USERNAME/PASSWORD empty to log in yourself in the
# interactive live-view tab (https://ai.cuhk.edu.cn/chat/).
# ------------------------------------------------------------
# Student: full ID e.g. 1XXXXXXX (or yourname@cuhk.edu.cn)
USERNAME=
PASSWORD=

# Local OpenAI-compatible key for Cursor / Codex / HTTP clients.
# Base URL: http://127.0.0.1:8766/v1
WEB2API_API_KEY=
