# Copy manually to .env.v2. Process variables take precedence.
WEB2API_V2_API_KEY=replace-with-a-long-random-secret
WEB2API_V2_BACKEND=httpx
WEB2API_V2_DATA_DIR=.web2api-v2/runtime
# Explicit output folder from the manual diagnosis; never legacy cookies.
WEB2API_V2_AUTH_DIR=.web2api-v2/auth-CHANGE-ME
WEB2API_V2_HOST=127.0.0.1
WEB2API_V2_PORT=8767
WEB2API_V2_CONCURRENCY=1
WEB2API_V2_INTERVAL=20
# Choose an actual current campus approach ID from diagnosis, not a guessed alias.
WEB2API_V2_MODEL=
# Keep buffered until the baseline is recorded. Incremental is opt-in.
WEB2API_V2_STREAM_MODE=buffered
# A successful incremental --chat diagnostic report is needed to advertise
# streaming=true and enable experimental Playwright concurrency > 1.
WEB2API_V2_STREAM_VALIDATION=
# Authentication reload accepts only a direct child directory under this root.
WEB2API_V2_AUTH_ROOT=.web2api-v2
